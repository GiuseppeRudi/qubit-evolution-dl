# ============================
# Git ignore for tf-project
# ============================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
venv/
env/
.env/
.conda/
.conda_env/
pip-wheel-metadata/

# Build / distribution
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# Logs / temp
logs/
*.log
tmp/
temp/
*.tmp

# IDE / editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS-specific
.DS_Store
Thumbs.db

# Large data / training artifacts
data/
datasets/
models/
checkpoints/
outputs/
runs/

# Docker stuff (keep Dockerfile, ignore extra local files)
docker-compose.override.yml
*.local.yml
